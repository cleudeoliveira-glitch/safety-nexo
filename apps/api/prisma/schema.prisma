generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Consultoria SST: é o "tenant". Cada consultoria só enxerga os próprios dados.
model Consultoria {
  id        String    @id @default(cuid())
  nome      String
  plano     String    @default("FREE")
  limiteEmpresas Int  @default(3)
  logoPath  String?   // logo da consultoria: vai no rodapé dos documentos
  // Dados comerciais: aparecem na proposta, no contrato e na cobrança Pix.
  cnpj      String?
  cidade    String?
  pixChave  String?
  pixNome   String?   // nome do recebedor, como no banco (até 25 letras no QR)
  createdAt DateTime  @default(now())
  empresas  Empresa[]
  usuarios  Usuario[]
  propostas Proposta[]
  contratos Contrato[]
  servicos  Servico[]
  cobrancas Cobranca[]
}

model Empresa {
  id             String        @id @default(cuid())
  consultoriaId  String
  consultoria    Consultoria   @relation(fields: [consultoriaId], references: [id], onDelete: Cascade)
  razaoSocial    String
  cnpj           String
  cnae           String?
  grauRisco      Int?
  numFuncionarios Int          @default(0)
  logoPath       String?       // logo da empresa cliente: vai no cabeçalho dos documentos
  medicoPcmsoNome String?      // médico responsável pelo PCMSO (NR-07)
  medicoPcmsoCrm  String?
  responsavelTecnicoNome     String? // assina LTCAT e registros ambientais do PPP
  responsavelTecnicoRegistro String? // CREA ou CRM
  representanteLegalNome     String? // assina o PPP pela empresa
  // eSocial: dados extras dos responsáveis (S-2220 respMonit, S-2240 respReg) e ambiente de envio.
  medicoPcmsoCpf             String?
  medicoPcmsoUf              String?
  responsavelTecnicoCpf      String?
  responsavelTecnicoConselho String? // CRM, CREA ou OUTRO
  responsavelTecnicoUf       String?
  esocialAmbiente            String  @default("PRODUCAO_RESTRITA") // PRODUCAO_RESTRITA (testes) ou PRODUCAO
  atendidaSesmt   Boolean      @default(false) // com SESMT, ele cumpre o papel da CIPA (NR-05, 5.4.13.1)
  cipaInicioMandato DateTime?  // início do mandato atual da CIPA (ou do representante nomeado)
  cipaRepresentante String?    // representante nomeado quando a empresa fica abaixo do Quadro I
  createdAt      DateTime      @default(now())
  colaboradores  Colaborador[]
  ghes           Ghe[]
  documentos     Documento[]
  eleicoesCipa   CipaEleicao[]
  aprs           Apr[]
  permissoes     PermissaoTrabalho[]
  ddss           Dds[]
  turmas         Turma[]
  usuarios       Usuario[]
  aets           Aet[]
  cats           Cat[]
  afastamentos   Afastamento[]
  propostas      Proposta[]
  contratos      Contrato[]
  servicos       Servico[]
  cobrancas      Cobranca[]
  inspecoes      Inspecao[]
  eventosEsocial EventoEsocial[]
  controlesEmergencia ControleEmergencia[]
  terceiros      Terceiro[]
  arquivos       Arquivo[]
  pedidosAssinatura PedidoAssinatura[]
  avaliacoesPsicossociais AvaliacaoPsicossocial[]
  sipats         Sipat[]
  auditorias5s   Auditoria5s[]
  atestados      Atestado[]
  fapRat         FapRat[]
  jornadaDiariaHoras Float @default(8) // para o índice de absenteísmo
  // Brigada e plano de emergência: divisão de ocupação (IT-17 SP), risco, população por pavimento, ponto de encontro e contatos.
  emergencia     Json?

  @@unique([consultoriaId, cnpj])
  @@index([consultoriaId])
}

model Colaborador {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  cpf           String?
  cargo         String
  cbo           String?
  matricula     String?  // matrícula do vínculo no eSocial (S-2200)
  codCateg      String?  // categoria eSocial, só para quem não tem matrícula (ex.: estagiário)
  dataAdmissao  DateTime?
  gheId         String?
  ghe           Ghe?     @relation(fields: [gheId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  asos          Aso[]
  entregasEpi   EntregaEpi[]
  cipa          CipaMembro[]
  treinamentos  Participacao[]
  cats          Cat[]
  afastamentos  Afastamento[]
  atestados     Atestado[]

  @@index([empresaId])
}

// GHE = Grupo Homogêneo de Exposição: conjunto de pessoas com exposição parecida.
model Ghe {
  id            String        @id @default(cuid())
  empresaId     String
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  // Periculosidade (NR-16): anexo que enquadra a atividade do GHE, ou NENHUM quando avaliado e não perigoso.
  periculosidadeAnexo         String?
  periculosidadeJustificativa String?
  riscos        GheRisco[]
  exames        ExameGhe[]
  colaboradores Colaborador[]

  @@index([empresaId])
}

model GheRisco {
  id          String  @id @default(cuid())
  gheId       String
  ghe         Ghe     @relation(fields: [gheId], references: [id], onDelete: Cascade)
  tipo        String  // FISICO, QUIMICO, BIOLOGICO, ERGONOMICO, ACIDENTE
  agente      String
  fonteGeradora String
  medidasControle String?
  severidade  String  @default("MEDIA") // BAIXA, MEDIA, ALTA
  // Avaliação do agente: base do LTCAT e do PPP (registros ambientais / S-2240).
  tipoAvaliacao       String?  // QUALITATIVA | QUANTITATIVA
  intensidade         String?  // resultado medido, com unidade. Ex.: 88 dB(A)
  limiteTolerancia    String?  // Ex.: 85 dB(A)
  // Insalubridade (NR-15): anexo e grau (NAO, MINIMO, MEDIO, MAXIMO).
  anexoNr15           String?
  grauInsalubridade   String?
  tecnicaMedicao      String?  // Ex.: NHO-01 Fundacentro
  epcEficaz           Boolean?
  epiEficaz           Boolean?
  epiCa               String?
  codigoAnexoIv       String?  // código do Anexo IV do Decreto 3.048/99, quando enquadra
  aposentadoriaEspecial Boolean @default(false) // conclusão do responsável técnico
  // eSocial S-2240: código da Tabela 24, unidade de medida, uso de EPC/EPI e requisitos da NR-06.
  esocial             Json?

  @@index([gheId])
}

model Documento {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo        String   // PGR, PCMSO, LTCAT...
  versao      Int      @default(1)
  vencimento  DateTime?
  geradoEm    DateTime @default(now())

  @@index([empresaId])
}

// NR-04 Anexo I (Quadro I): grau de risco por classe CNAE (XX.XX-X).
// Preenchida pelo script scripts/importar-nr04, a partir do texto oficial da norma.
model CnaeGrauRisco {
  classe      String @id
  denominacao String
  grauRisco   Int
}

// Exame programado no PCMSO para um GHE, com os momentos em que é feito (NR-07).
model ExameGhe {
  id                 String  @id @default(cuid())
  gheId              String
  ghe                Ghe     @relation(fields: [gheId], references: [id], onDelete: Cascade)
  nome               String
  tipo               String  // CLINICO, COMPLEMENTAR
  admissional        Boolean @default(true)
  periodico          Boolean @default(true)
  retornoTrabalho    Boolean @default(false)
  mudancaRisco       Boolean @default(false)
  demissional        Boolean @default(false)
  periodicidadeMeses Int?
  codigoEsocial      String? // procedimento da Tabela 27 do eSocial (4 dígitos)

  @@index([gheId])
}

// Pessoa que entra no sistema. Pertence a uma consultoria.
model Usuario {
  id            String      @id @default(cuid())
  consultoriaId String
  consultoria   Consultoria @relation(fields: [consultoriaId], references: [id], onDelete: Cascade)
  nome          String
  email         String      @unique
  senhaHash     String
  papel         String      @default("CONSULTORIA") // CONSULTORIA (todas as empresas) | EMPRESA (só a dela)
  empresaId     String?
  empresa       Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([consultoriaId])
}

// Atestado de Saúde Ocupacional (NR-07). Os exames ficam gravados como foram no dia.
model Aso {
  id                   String      @id @default(cuid())
  colaboradorId        String
  colaborador          Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo                 String      // ADMISSIONAL, PERIODICO, RETORNO_TRABALHO, MUDANCA_RISCO, DEMISSIONAL
  dataExame            DateTime
  resultado            String      // APTO, INAPTO
  medicoExaminadorNome String
  medicoExaminadorCrm  String
  medicoExaminadorUf   String?
  exames               String[]
  riscos               String[]
  proximoExame         DateTime?
  observacoes          String?
  createdAt            DateTime    @default(now())

  @@index([colaboradorId])
}

// Entrega de EPI registrada na ficha do colaborador (NR-06).
model EntregaEpi {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  epi           String
  ca            String
  validadeCa    DateTime?
  quantidade    Int         @default(1)
  motivo        String      // ENTREGA_INICIAL, DESGASTE, PERDA, DANO
  dataEntrega   DateTime
  createdAt     DateTime    @default(now())

  @@index([colaboradorId])
}

// Um processo eleitoral da CIPA (NR-05, 5.5): do edital ao treinamento dos eleitos.
model CipaEleicao {
  id                String       @id @default(cuid())
  empresaId         String
  empresa           Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  editalEm          DateTime
  inscricaoInicio   DateTime
  inscricaoFim      DateTime
  eleicaoEm         DateTime
  localVotacao      String
  horarioVotacao    String
  votantes          Int?         // quem votou: define a participação mínima (5.5.4)
  posseEm           DateTime?
  treinamentoInicio DateTime?
  treinamentoFim    DateTime?
  instrutor         String?
  createdAt         DateTime     @default(now())
  membros           CipaMembro[]

  @@index([empresaId])
}

// Candidato dos empregados (com votos) ou indicado da organização.
model CipaMembro {
  id            String      @id @default(cuid())
  eleicaoId     String
  eleicao       CipaEleicao @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  representacao String      // EMPREGADOS | ORGANIZACAO
  votos         Int?        // só para candidatos dos empregados
  titular       Boolean     @default(true) // só para indicados da organização
  presidente    Boolean     @default(false) // indicado pela organização (5.4.5)
  vice          Boolean     @default(false) // escolhido entre os titulares eleitos (5.4.5)
  createdAt     DateTime    @default(now())

  @@unique([eleicaoId, colaboradorId])
}

// Análise Preliminar de Risco de uma atividade.
model Apr {
  id           String              @id @default(cuid())
  empresaId    String
  empresa      Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero       Int                 // sequencial por empresa
  atividade    String
  local        String
  data         DateTime
  responsavel  String
  equipe       String[]            // ids de colaboradores
  etapas       Json                // [{ etapa, riscos, medidas, epis }]
  createdAt    DateTime            @default(now())
  permissoes   PermissaoTrabalho[]

  @@unique([empresaId, numero])
}

// Permissão de Trabalho para atividade de risco (altura, espaço confinado, quente, elétrica).
model PermissaoTrabalho {
  id          String    @id @default(cuid())
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero      Int
  tipo        String    // ALTURA | ESPACO_CONFINADO | QUENTE | ELETRICIDADE
  aprId       String?
  apr         Apr?      @relation(fields: [aprId], references: [id], onDelete: SetNull)
  atividade   String
  local       String
  inicio      DateTime
  fim         DateTime
  executantes String[]  // ids de colaboradores
  emitente    String
  checklist   Json      // [{ item, ok }]
  encerradaEm DateTime?
  createdAt   DateTime  @default(now())

  @@unique([empresaId, numero])
}

// Diálogo Diário de Segurança com lista de presença.
model Dds {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tema          String
  conteudo      String
  data          DateTime
  duracaoMin    Int
  ministrante   String
  participantes String[] // ids de colaboradores
  createdAt     DateTime @default(now())

  @@index([empresaId])
}

// Turma de um treinamento (NR-35, NR-10, integração...). Vale para todos os participantes.
model Turma {
  id                 String         @id @default(cuid())
  empresaId          String
  empresa            Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  norma              String?
  cargaHoraria       Int
  validadeMeses      Int?           // sem validade fixa = null
  conteudo           String[]       // conteúdo programático
  inicio             DateTime
  fim                DateTime
  local              String
  instrutor          String
  qualificacao       String         // qualificação do instrutor
  responsavelTecnico String
  createdAt          DateTime       @default(now())
  participantes      Participacao[]

  @@index([empresaId])
}

// Participante de uma turma. O código vai no QR Code do certificado.
model Participacao {
  id            String      @id @default(cuid())
  turmaId       String
  turma         Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  codigo        String      @unique
  createdAt     DateTime    @default(now())

  @@unique([turmaId, colaboradorId])
}

// Análise Ergonômica do Trabalho (NR-17, item 17.3).
model Aet {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  posto          String   // posto, setor ou atividade analisada
  data           DateTime
  responsavel    String
  demanda        String   // análise da demanda
  funcionamento  String   // organização, processos, situações de trabalho e atividade
  metodos        String   // métodos, técnicas e ferramentas usados e por quê
  diagnostico    String
  recomendacoes  Json     // [{ recomendacao, prazo, responsavel }]
  restituicao    String   // restituição e validação com os trabalhadores
  createdAt      DateTime @default(now())

  @@index([empresaId])
}

// Comunicação de Acidente de Trabalho (dados do S-2210).
model Cat {
  id               String      @id @default(cuid())
  empresaId        String
  empresa          Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipoCat          String      // INICIAL | REABERTURA | OBITO
  tipoAcidente     String      // TIPICO | TRAJETO | DOENCA
  dataHora         DateTime
  horasTrabalhadas String?     // horas trabalhadas antes do acidente. Ex.: 03:30
  local            String
  parteAtingida    String
  agenteCausador   String
  naturezaLesao    String
  descricao        String
  houveAfastamento Boolean
  houveObito       Boolean     @default(false)
  registroPolicial Boolean     @default(false)
  testemunhas      String?
  atendimentoData  DateTime?
  medicoNome       String?
  medicoCrm        String?
  cid              String?
  diasTratamento   Int?
  enviadaEm        DateTime?   // quando foi transmitida ao eSocial
  recibo           String?     // número do recibo do eSocial
  // eSocial S-2210: códigos das tabelas 13, 14/15 e 17, local e atestado.
  esocial          Json?
  createdAt        DateTime    @default(now())

  @@index([empresaId])
}

// Inspeção por checklist de NR (feita pela consultoria ou pela própria empresa).
model Inspecao {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modelo    String   // NR-06, NR-10, NR-12, NR-23, NR-24 ou LIVRE
  titulo    String
  local     String
  data      DateTime
  inspetor  String
  itens     Json     // [{ texto, resposta: C | NC | NA, observacao }]
  createdAt DateTime @default(now())

  @@index([empresaId])
}

// AVCB, CLCB, extintores, hidrantes e outros itens de emergência com validade.
model ControleEmergencia {
  id        String    @id @default(cuid())
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo      String    // AVCB, CLCB, EXTINTOR, HIDRANTE, ILUMINACAO, ALARME, SPDA, OUTRO
  descricao String
  local     String?
  numero    String?
  validade  DateTime?
  createdAt DateTime  @default(now())

  @@index([empresaId])
}

// Certificado digital A1 (e-CNPJ ou e-CPF) da consultoria, usado para transmitir ao eSocial.
// O arquivo e a senha ficam cifrados (AES-256-GCM) com a chave CERT_SECRET do servidor.
model CertificadoDigital {
  id            String   @id @default(cuid())
  consultoriaId String   @unique
  titular       String
  documento     String   // CNPJ ou CPF do certificado (é o transmissor)
  tipoDocumento String   // CNPJ | CPF
  validoDe      DateTime
  validoAte     DateTime
  pfxCifrado    String   // base64(iv | tag | dados)
  senhaCifrada  String
  createdAt     DateTime @default(now())
}

// Fila de eventos de SST do eSocial.
model EventoEsocial {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo         String   // S-2210, S-2220, S-2240
  referenciaId String   // CAT, ASO ou colaborador de origem
  descricao    String
  idEvento     String   @unique
  xml          String   // XML do evento já assinado
  ambiente     String   // PRODUCAO_RESTRITA | PRODUCAO
  status       String   @default("PENDENTE") // PENDENTE, ENVIADO, PROCESSADO, ERRO
  protocolo    String?
  recibo       String?
  mensagens    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId])
}

// Afastamento temporário (S-2230). Motivo pela Tabela 18 do eSocial.
model Afastamento {
  id               String      @id @default(cuid())
  empresaId        String
  empresa          Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaboradorId    String
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  motivo           String      // código da Tabela 18 (ex.: 01 acidente/doença do trabalho)
  inicio           DateTime    @db.Date
  fim              DateTime?   @db.Date // último dia afastado; vazio enquanto continua afastado
  mesmoMotivo      Boolean?    // mesma doença de afastamento anterior em 60 dias (motivos 01 e 03)
  acidenteTransito Int?        // 1 atropelamento, 2 colisão, 3 outros
  observacao       String?
  catId            String?     // CAT que originou, quando houver
  createdAt        DateTime    @default(now())

  @@index([empresaId])
}

// Histórico de alterações: quem fez o quê, quando (gravado automaticamente a cada alteração ou documento gerado).
model Historico {
  id            String   @id @default(cuid())
  consultoriaId String
  empresaId     String?
  usuarioId     String
  usuarioNome   String
  papel         String   // CONSULTORIA | EMPRESA
  acao          String   // descrição em português
  metodo        String
  rota          String
  createdAt     DateTime @default(now())

  @@index([consultoriaId, createdAt])
  @@index([empresaId, createdAt])
}

// ---------- Comercial (valores em centavos) ----------
model Proposta {
  id            String      @id @default(cuid())
  consultoriaId String
  consultoria   Consultoria @relation(fields: [consultoriaId], references: [id], onDelete: Cascade)
  numero        Int
  empresaId     String?
  empresa       Empresa?    @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  clienteNome   String      // cliente ainda não cadastrado também recebe proposta
  clienteCnpj   String?
  clienteContato String?
  data          DateTime    @db.Date
  validadeDias  Int         @default(15)
  itens         Json        // [{ descricao, quantidade, valorCentavos }]
  observacoes   String?
  status        String      @default("ABERTA") // ABERTA, ACEITA, RECUSADA
  createdAt     DateTime    @default(now())
  contratos     Contrato[]

  @@unique([consultoriaId, numero])
}

model Contrato {
  id            String      @id @default(cuid())
  consultoriaId String
  consultoria   Consultoria @relation(fields: [consultoriaId], references: [id], onDelete: Cascade)
  numero        Int
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  propostaId    String?
  proposta      Proposta?   @relation(fields: [propostaId], references: [id], onDelete: SetNull)
  objeto        String      // serviços contratados
  valorMensalCentavos Int?  // mensalidade; vazio quando o contrato é só por serviço
  diaVencimento Int?        // dia do mês da mensalidade
  inicio        DateTime    @db.Date
  fim           DateTime?   @db.Date
  observacoes   String?
  status        String      @default("ATIVO") // ATIVO, ENCERRADO
  createdAt     DateTime    @default(now())
  servicos      Servico[]
  cobrancas     Cobranca[]

  @@unique([consultoriaId, numero])
}

// Ordem de serviço comercial: um trabalho a executar para o cliente (visita, laudo, treinamento).
model Servico {
  id            String      @id @default(cuid())
  consultoriaId String
  consultoria   Consultoria @relation(fields: [consultoriaId], references: [id], onDelete: Cascade)
  numero        Int
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId    String?
  contrato      Contrato?   @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  descricao     String
  previsto      DateTime?   @db.Date
  responsavel   String?
  valorCentavos Int?        // valor avulso, cobrado à parte do contrato
  concluidoEm   DateTime?   @db.Date
  status        String      @default("ABERTA") // ABERTA, CONCLUIDA, CANCELADA
  createdAt     DateTime    @default(now())
  cobrancas     Cobranca[]

  @@unique([consultoriaId, numero])
}

model Cobranca {
  id            String      @id @default(cuid())
  consultoriaId String
  consultoria   Consultoria @relation(fields: [consultoriaId], references: [id], onDelete: Cascade)
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId    String?
  contrato      Contrato?   @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  servicoId     String?
  servico       Servico?    @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  descricao     String
  valorCentavos Int
  vencimento    DateTime    @db.Date
  referencia    String?     // mês da mensalidade (AAAA-MM), evita cobrar duas vezes
  txid          String      // identificador no Pix
  status        String      @default("ABERTA") // ABERTA, PAGA, CANCELADA
  pagoEm        DateTime?   @db.Date
  createdAt     DateTime    @default(now())

  @@index([consultoriaId, vencimento])
  @@unique([contratoId, referencia])
}

// Empresa prestadora de serviço que trabalha dentro do cliente (terceirizada).
model Terceiro {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  razaoSocial   String
  cnpj          String?
  servico       String
  contato       String?
  telefone      String?
  inicio        DateTime? @db.Date
  fim           DateTime? @db.Date
  createdAt     DateTime @default(now())
  documentos    TerceiroDocumento[]
  trabalhadores TerceiroTrabalhador[]

  @@index([empresaId])
}

model TerceiroDocumento {
  id          String    @id @default(cuid())
  terceiroId  String
  terceiro    Terceiro  @relation(fields: [terceiroId], references: [id], onDelete: Cascade)
  tipo        String
  validade    DateTime? @db.Date
  observacao  String?
  createdAt   DateTime  @default(now())

  @@index([terceiroId])
}

model TerceiroTrabalhador {
  id           String    @id @default(cuid())
  terceiroId   String
  terceiro     Terceiro  @relation(fields: [terceiroId], references: [id], onDelete: Cascade)
  nome         String
  cpf          String?
  funcao       String?
  asoValidade  DateTime? @db.Date
  integracao   DateTime? @db.Date // data da integração de segurança feita no cliente
  treinamentos Json      @default("[]") // [{ nome, validade }]
  createdAt    DateTime  @default(now())

  @@index([terceiroId])
}

// Atestado médico de falta (não é o ASO). Base do absenteísmo.
model Atestado {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  inicio        DateTime    @db.Date
  dias          Int         @default(0) // dias de afastamento; 0 quando for só por horas
  horas         Float?      // atestado de comparecimento por horas
  tipo          String      // DOENCA, ACIDENTE_TRABALHO, ACOMPANHAMENTO, ODONTOLOGICO, OUTRO
  cid           String?
  medico        String?
  observacao    String?
  createdAt     DateTime    @default(now())

  @@index([empresaId, inicio])
  @@index([colaboradorId])
}

// Arquivo de documentos (GED): cada PDF gerado fica guardado, e a consultoria ou o RH podem enviar outros.
// Mesma "chave" = versões do mesmo documento.
model Arquivo {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chave         String
  titulo        String
  categoria     String
  origem        String   // GERADO ou ENVIADO
  versao        Int
  nomeArquivo   String
  mime          String
  tamanho       Int
  caminho       String
  texto         String?  @db.Text
  descricao     String?
  criadoPorId   String?
  criadoPorNome String
  criadoEm      DateTime @default(now())
  acessos       ArquivoAcesso[]

  @@index([empresaId, chave])
  @@index([empresaId, criadoEm])
}

model ArquivoAcesso {
  id          String   @id @default(cuid())
  arquivoId   String
  arquivo     Arquivo  @relation(fields: [arquivoId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuarioNome String
  papel       String
  em          DateTime @default(now())

  @@index([arquivoId])
}

// Pedido de assinatura de um PDF do arquivo. Quando todos assinam, sai o PDF final com a folha de
// assinaturas (e o certificado ICP-Brasil da consultoria, se pedido).
model PedidoAssinatura {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  arquivoId      String   // versão do documento que está sendo assinada
  titulo         String
  status         String   @default("ABERTO") // ABERTO, CONCLUIDO, CANCELADO
  codigo         String   @unique // código público de conferência
  hashOriginal   String
  icp            Boolean  @default(false)
  icpTitular     String?
  arquivoFinalId String?
  hashFinal      String?
  criadoPorNome  String
  criadoEm       DateTime @default(now())
  concluidoEm    DateTime?
  signatarios    Signatario[]

  @@index([empresaId])
}

model Signatario {
  id         String           @id @default(cuid())
  pedidoId   String
  pedido     PedidoAssinatura @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  ordem      Int
  nome       String
  cpf        String?
  papel      String
  token      String           @unique // link para assinar sem login
  assinadoEm DateTime?
  imagem     String?          @db.Text // desenho da assinatura (PNG em data URI)
  latitude   Float?
  longitude  Float?
  precisao   Float?
  ip         String?
  navegador  String?
  presencial Boolean          @default(false) // assinou no aparelho de quem pediu

  @@index([pedidoId])
}

// Avaliação psicossocial: questionário anônimo respondido por link. Sem nome, sem e-mail, sem IP:
// só o setor (GHE) e as respostas. Resultado aparece por setor só com o mínimo de respostas.
model AvaliacaoPsicossocial {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  questionario String   // id em src/psicossocial/questionarios.ts
  titulo       String
  status       String   @default("ABERTA") // ABERTA, ENCERRADA
  token        String   @unique
  minimoGrupo  Int      @default(5)
  criadoPorNome String
  criadoEm     DateTime @default(now())
  encerradaEm  DateTime?
  respostas    RespostaPsicossocial[]
  acoes        AcaoPsicossocial[]

  @@index([empresaId])
}

model RespostaPsicossocial {
  id          String   @id @default(cuid())
  avaliacaoId String
  avaliacao   AvaliacaoPsicossocial @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  setor       String
  valores     Json     // { "1": 0, "2": 1, ... }
  dia         DateTime @db.Date // só o dia, para não identificar pela hora

  @@index([avaliacaoId])
}

model AcaoPsicossocial {
  id          String   @id @default(cuid())
  avaliacaoId String
  avaliacao   AvaliacaoPsicossocial @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  setor       String?
  dimensao    String
  acao        String
  responsavel String?
  prazo       DateTime? @db.Date
  feita       Boolean  @default(false)
  criadoEm    DateTime @default(now())

  @@index([avaliacaoId])
}

// SIPAT: semana de prevenção, com a programação e a presença de cada atividade.
model Sipat {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ano        Int
  tema       String
  inicio     DateTime @db.Date
  fim        DateTime @db.Date
  criadoEm   DateTime @default(now())
  atividades SipatAtividade[]

  @@index([empresaId])
}

model SipatAtividade {
  id          String   @id @default(cuid())
  sipatId     String
  sipat       Sipat    @relation(fields: [sipatId], references: [id], onDelete: Cascade)
  data        DateTime @db.Date
  horario     String
  titulo      String
  responsavel String   // palestrante ou quem conduz
  local       String
  duracaoMin  Int      @default(60)
  presentes   String[] // ids dos colaboradores que participaram

  @@index([sipatId])
}

// Auditoria 5S de um setor: nota de 0 a 4 em cada item do checklist.
model Auditoria5s {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  setor       String
  data        DateTime @db.Date
  auditor     String
  notas       Json     // { "seiri-1": 3, ... }
  observacoes String?
  criadoEm    DateTime @default(now())

  @@index([empresaId, setor])
}

// FAP/RAT por ano: o RAT (1, 2 ou 3%) vem do enquadramento da atividade e o FAP (0,5000 a 2,0000) é divulgado pela Previdência para cada empresa.
model FapRat {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ano         Int
  rat         Int
  fap         Decimal  @db.Decimal(5, 4)
  folhaMensal Decimal? @db.Decimal(14, 2)
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, ano])
}
