# Servidor (API) do Safety Nexo. Copie para .env e preencha. Nunca suba o .env para o GitHub.
DATABASE_URL=postgresql://usuario:senha@host:5432/safety_nexo
PORT=8080
WEB_ORIGIN=https://seu-site.netlify.app

# Segredos: gere textos longos e aleatórios (mínimo 32 caracteres cada).
JWT_SECRET=
CERT_SECRET=

# Pastas onde ficam os arquivos e logos (no Railway, aponte para o volume /data).
ARQUIVOS_DIR=/data/arquivos
LOGOS_DIR=/data/logos
CHROMIUM_PATH=/usr/bin/chromium

# Leitura de PGR antigo com IA (opcional).
ANTHROPIC_API_KEY=

# Reconhecimento facial (face-api.js no navegador, custo zero).
FACE_API_ENABLED=true
FACE_RECOGNITION_THRESHOLD=0.6
LGPD_FACIAL_CONSENT_REQUIRED=true
# Prova de vida: a pessoa pisca os olhos antes de confirmar (foto parada não passa).
FACE_LIVENESS_REQUIRED=true
# Prova de vida com AWS Rekognition: plano Enterprise, ainda não ligado.
AWS_REKOGNITION_ENABLED=false
